---
import { getImage } from 'astro:assets';
import ogDefault from '../assets/og-default.png';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import {
  ADSENSE_ACCOUNT,
  ADSENSE_CLIENT,
  SITE_NAME,
  UMAMI_WEBSITE_ID,
  WEBMCP_ORIGIN_TRIAL,
} from '../data/site.js';
import {
  DEFAULT_IMAGE_ALT,
  SOCIAL_WIDTH,
  SOCIAL_HEIGHT,
  SOCIAL_VERSION,
  structuredData,
  serializeJsonLd,
} from '../lib/meta.js';
import '../styles/global.css';

/**
 * @type {{ title: string, description: string, path: string, socialTitle?: string,
 * ogImage?: import('astro').ImageMetadata | null, ogImageAlt?: string,
 * items?: import('../lib/meta.js').ListedCard[], cardMetadata?: import('../lib/meta.js').CardMetadata,
 * noindex?: boolean }}
 */
const {
  title,
  description,
  path,
  socialTitle = title,
  ogImage = null,
  ogImageAlt = DEFAULT_IMAGE_ALT,
  items,
  cardMetadata,
  noindex = false,
} = Astro.props;
const site = /** @type {URL} */ (Astro.site);
const og = await getImage({
  src: ogImage ?? ogDefault,
  width: SOCIAL_WIDTH,
  height: SOCIAL_HEIGHT,
  format: 'jpg',
  socialPreview: SOCIAL_VERSION,
});
const canonical = new URL(path, site).href;
const image = {
  url: new URL(og.src, site).href,
  width: SOCIAL_WIDTH,
  height: SOCIAL_HEIGHT,
  alt: ogImage ? ogImageAlt : DEFAULT_IMAGE_ALT,
};
const schema = structuredData({
  title: socialTitle,
  description,
  path,
  image,
  items,
  card: cardMetadata,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="origin-trial" content={WEBMCP_ORIGIN_TRIAL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#140a1f" />
    <meta name="google-adsense-account" content={ADSENSE_ACCOUNT} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image.url} />
    <meta property="og:image:secure_url" content={image.url} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={image.width} />
    <meta property="og:image:height" content={image.height} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image.url} />
    <meta name="twitter:image:alt" content={image.alt} />
    {!noindex && <script is:inline type="application/ld+json" set:html={serializeJsonLd(schema)} />}
    {/* Cookieless page views and Web Vitals. Never add Umami's recorder.js: it is session replay and heatmaps. */}
    {/* async, not defer: a deferred tag that never loads holds back the site's own module scripts. */}
    {UMAMI_WEBSITE_ID && (
      <script
        is:inline
        async
        src="https://umami.lav.ren/script.js"
        data-website-id={UMAMI_WEBSITE_ID}
        data-domains={site.hostname}
        data-performance="true"
      />
    )}
    {/* Real ads on the apex only: staging and local visits never load them (Andrei, 2026-11-15). */}
    {ADSENSE_CLIENT && <script is:inline data-host={site.hostname} data-client={ADSENSE_CLIENT}>
      {
        const { host, client } = document.currentScript.dataset;
        if (location.hostname === host) {
          const s = document.createElement('script');
          s.async = true;
          s.crossOrigin = 'anonymous';
          s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + client;
          document.head.append(s);
        }
      }
    </script>}
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
