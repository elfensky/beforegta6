---
import { getCollection } from 'astro:content';
import { milestones } from '../data/milestones.js';
import Base from '../layouts/Base.astro';
import { withAdSlots } from '../lib/ads.js';
import { groupSlots, timelineEntries, yearOf } from '../lib/cards.js';
import TimelineItem from './TimelineItem.astro';

/** @typedef {'oldest' | 'newest'} Order */
/** @type {{ order: Order }} */
const { order } = Astro.props;
const entries = timelineEntries(await getCollection('cards'), milestones, order);
const cards = entries.filter((e) => e.kind === 'card');
const years = groupSlots(withAdSlots(entries), yearOf);
/** @param {Order} o */
const href = (o) => (o === 'oldest' ? '/oldest/' : '/');
/** @param {boolean} on */
const current = (on) => (on ? /** @type {const} */ ('page') : undefined);
---

<Base
  title="Everything we got before GTA 6 · beforegta6.wtf"
  description={`${cards.length} things that happened while the world waited for GTA 6.`}
  path="/"
>
  <h1 class="page-title" data-launch-title>
    Everything we got before GTA 6
  </h1>
  <nav class="toggles" aria-label="Timeline order">
    <p>
      <span>Order:</span>
      <a href={href('newest')} aria-current={current(order === 'newest')}>
        Newest first
      </a>
      <a href={href('oldest')} aria-current={current(order === 'oldest')}>
        Oldest first
      </a>
    </p>
  </nav>
  {years.map((year) => (
    <section class="year" aria-labelledby={`y${year.key}`}>
      <h2 id={`y${year.key}`}>
        <span>{year.key}</span>
      </h2>
      <ol class="timeline">
        {year.slots.map((slot) => (
          <TimelineItem slot={slot} />
        ))}
      </ol>
    </section>
  ))}
</Base>
