---
import { getCollection } from 'astro:content';
import { milestones } from '../data/milestones.js';
import Base from '../layouts/Base.astro';
import { timelineEntries, withMilestoneCards } from '../lib/cards.js';
import TimelineItem from './TimelineItem.astro';

/** @typedef {'oldest' | 'newest'} Order */
/** @type {{ order: Order }} */
const { order } = Astro.props;
const line = withMilestoneCards(await getCollection('cards'), milestones);
const entries = timelineEntries(line.cards, line.milestones, order);
const cards = entries.filter((e) => e.kind === 'card');
// The entries are in date order, so each year is one run and keeps its place.
const years = [...Map.groupBy(entries, (e) => e.year)];
/** @param {Order} o */
const href = (o) => (o === 'oldest' ? '/oldest/' : '/');
/** @param {boolean} on */
const current = (on) => (on ? /** @type {const} */ ('page') : undefined);
---

<Base
  title="Everything we got before GTA 6 · beforegta6.wtf"
  description={`${cards.length} things that happened while the world waited for GTA 6.`}
  path="/"
  items={(order === 'oldest' ? cards.toReversed() : cards).map((entry) => ({
    id: entry.card.id,
    title: entry.card.data.title,
  }))}
>
  <h1 class="page-title" data-launch-title>
    Everything we got before GTA 6
  </h1>
  {/* Shown by the countdown script at launch: the meme flips to "We got GTA 6 before ___" (Reddit, Nov 2026). */}
  <p class="after-launch" data-after-launch hidden>
    And we got GTA 6 before The Winds of Winter.
  </p>
  <nav class="toggles" aria-label="Timeline order">
    <p>
      <span>Order:</span>
      <a href={href('newest')} aria-current={current(order === 'newest')}>
        Newest first
      </a>
      <a href={href('oldest')} aria-current={current(order === 'oldest')}>
        Oldest first
      </a>
    </p>
  </nav>
  {years.map(([year, yearEntries]) => (
    <section class="year" aria-labelledby={`y${year}`}>
      <h2 id={`y${year}`}>
        <span>{year}</span>
      </h2>
      <ol class="timeline">
        {yearEntries.map((entry) => (
          <TimelineItem entry={entry} />
        ))}
      </ol>
    </section>
  ))}
  <script>
    import '../scripts/media.js';
  </script>
</Base>
