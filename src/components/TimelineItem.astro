---
import { Image } from 'astro:assets';
import { LAUNCH } from '../data/site.js';
import { splitTitle } from '../lib/cards.js';
import { daysBefore } from '../lib/countdown.js';

/** @type {{ entry: import('../lib/cards.js').TimelineEntry }} */
const { entry } = Astro.props;
const left = daysBefore(entry.date, LAUNCH);
const title =
  entry.kind === 'card' ? splitTitle(entry.card.data.title) : { before: '', event: '', after: '' };
/** @param {Date} d */
const iso = (d) => d.toISOString().slice(0, 10);
/** @param {Date} d */
const shown = (d) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
---

{entry.kind === 'milestone' ? (
  // The launch ends the line, whichever end the order puts it at.
  <li class:list={['milestone', { cap: left === 0 }]}>
    <time datetime={iso(entry.date)}>
      {shown(entry.date)}
      {left === 0 && ` ${entry.year}`}
    </time>
    <p class="t-title">
      <span aria-hidden="true">◆</span>{' '}
      {entry.milestone.href ? (
        <a href={entry.milestone.href}>{entry.milestone.title}</a>
      ) : (
        entry.milestone.title
      )}
    </p>
    <p>
      {entry.milestone.blurb}{' '}
      <a href={entry.milestone.factUrl} rel="noopener">
        source<span class="sr-only"> of “{entry.milestone.title}”</span>{' '}
        <span aria-hidden="true">↗</span>
      </a>
    </p>
  </li>
) : (
  <li class="entry">
    <time class="date" datetime={iso(entry.date)}>
      {shown(entry.date)}
    </time>
    <span class="node" aria-hidden="true" />
    <div class="what">
      <p class="t-title">
        <a href={`/${entry.card.id}/`}>
          <span class="frame">{title.before}</span>
          {title.event}
          <span class="frame">{title.after}</span>
        </a>
      </p>
      {left > 0 && (
        <span class="days">
          {left.toLocaleString('en-GB')} {left === 1 ? 'day' : 'days'}
        </span>
      )}
    </div>
    {/* Desktop hover only. display: none at rest, so the lazy image loads only when it shows. */}
    {entry.card.data.nsfw ? (
      <figure class="media nsfw" aria-hidden="true">
        <span>NSFW</span>
      </figure>
    ) : (
      <figure class="media">
        <Image
          src={entry.card.data.image}
          alt=""
          width={256}
          widths={[256, 512]}
          sizes="16rem"
          loading="lazy"
        />
        {entry.card.data.imageCredit && (
          <figcaption>photo: {entry.card.data.imageCredit.text}</figcaption>
        )}
      </figure>
    )}
  </li>
)}
